{
  "name": "flowsim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild app.js --bundle --format=esm --minify --outfile=app.bundle.js && esbuild stl-worker.js --bundle --format=esm --minify --outfile=stl-worker.bundle.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
